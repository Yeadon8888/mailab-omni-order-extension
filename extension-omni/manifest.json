{
  "manifest_version": 3,
  "name": "MAILAB OMNI VIDEO",
  "version": "1.1.1",
  "description": "MAILAB Omni 批量接单、自动投喂 Flow、生成监控、R2 转存与飞书回填工具。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "显示或隐藏 MAILAB Omni 接单面板"
  },
  "permissions": [
    "tabs",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://genvideo.mailab.top/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "flow-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
