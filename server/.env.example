PORT=8787
ALLOWED_ORIGINS=*

# License keys for capture-only extension.
# Format: key:name:expiresAt:active,key2:name2:expiresAt:active
MAILAB_LICENSE_KEYS=MAILAB-YYYY-001:测试用户:2026-12-31:true

# Admin key for maintenance endpoints such as /api/archive-retry.
MAILAB_ADMIN_KEY=

# Feishu app credentials. Keep these only on the server.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Base URL from the browser address bar.
FEISHU_BASE_URL=https://example.feishu.cn/base/YOUR_BASE_TOKEN?table=YOUR_TABLE_ID&view=YOUR_VIEW_ID
FEISHU_APP_TOKEN=YOUR_BASE_TOKEN
FEISHU_TABLE_ID=YOUR_TABLE_ID
FEISHU_PENDING_VIEW_NAME=待接单
FEISHU_PENDING_VIEW_ID=YOUR_PENDING_VIEW_ID

# Field names in the table. Change these to match the real Base schema.
FIELD_PROMPT=提示词
FIELD_IMAGE_URL=图片地址
FIELD_STATUS=任务状态
FIELD_ASSIGNEE=接单人
FIELD_CLAIMED_AT=接单时间
FIELD_COMPLETED_AT=完成时间
FIELD_VIDEO_URL=视频地址
FIELD_FAIL_COUNT=失败次数
FIELD_LOG=接单日志
FIELD_LOCK_ID=接单锁ID
FIELD_WATERMARK_URL=去水印原始链接
FIELD_LAST_ERROR=最后错误
FIELD_PLATFORM=制作平台
WRITE_WATERMARK_URL=false

STATUS_PENDING=待接单
STATUS_IN_PROGRESS=接单中
STATUS_DONE=已完成
STATUS_FAILED=失败
STATUS_GARBAGE=垃圾任务
MAX_FAIL_COUNT=3

# Watermark provider: zhuceka | doubao | qsy
WATERMARK_PROVIDER=zhuceka

# Zhuceka provider. Keep UID and KEY only on the server.
ZHUCEKA_API_URL=https://api.zhuceka.cn/home/api
ZHUCEKA_UID=
ZHUCEKA_KEY=

# Existing watermark-removal API used by the current extension.
DOUBAO_API_ORIGIN=https://api.sdtmp.com/tools/doubao
DOUBAO_AUTH_TOKEN=

# QSY mini-program compatible provider. Use only with authorization.
QSY_BASE_URL=
QSY_OPENID=
QSY_REFERER=
QSY_USER_AGENT=

# Used when the extension's test mode is enabled.
MAILAB_TEST_VIDEO_URL=https://example.com/mailab-test-video.mp4

# Optional async video archive. Defaults off so completion still writes the
# original video URL immediately. Archive failures only write logs and do not
# roll back completed orders. Keep concurrency low unless the server has enough
# bandwidth, disk, and CPU for multiple video downloads/uploads.
OSS_ARCHIVE_ENABLED=false
# If true, archive success will replace the Feishu video field with the R2 URL.
OSS_ARCHIVE_WRITE_BACK=false
OSS_ARCHIVE_CONCURRENCY=1
OSS_ARCHIVE_RETRY_COUNT=3
OSS_ARCHIVE_RETRY_DELAY_MS=5000
OSS_ARCHIVE_PUBLIC_VERIFY_ATTEMPTS=8
OSS_ARCHIVE_PUBLIC_VERIFY_DELAY_MS=5000
OSS_ARCHIVE_MAX_PREPARED_FILES=20
OSS_PROVIDER=wrangler-r2
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PREFIX=mailab/videos
R2_JURISDICTION=
CLOUDFLARE_WRANGLER_BIN=wrangler
CLOUDFLARE_WRANGLER_CWD=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OSS_MAX_VIDEO_BYTES=524288000
OSS_DOWNLOAD_TIMEOUT_MS=180000
OSS_UPLOAD_TIMEOUT_MS=180000
