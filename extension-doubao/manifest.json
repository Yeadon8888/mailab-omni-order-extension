{
  "manifest_version": 3,
  "name": "MAILAB GEN VIDEO",
  "version": "1.4.3",
  "description": "MAILAB 公网接单、素材复制、去水印回写飞书与豆包平台标记工具。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MAILAB GEN VIDEO"
  },
  "permissions": [
    "debugger",
    "tabs",
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "doubao-skill-pack-response.json",
        "dola-skill-pack-response.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
